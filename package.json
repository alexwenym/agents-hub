{
  "name": "agent-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local dashboard for monitoring and directing Claude Code agents",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "service:install": "sh scripts/service.sh install",
    "service:uninstall": "sh scripts/service.sh uninstall",
    "service:restart": "sh scripts/service.sh restart",
    "service:status": "sh scripts/service.sh status",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  }
}
